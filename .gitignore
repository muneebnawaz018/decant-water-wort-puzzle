# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local modules keep their *source* — only the Gradle output is generated.
#
# The rules above are anchored to the repo root, so they miss
# `modules/<name>/android/build/`, and 223 build artifacts were committed before
# anyone noticed: `.jar`, `.dex`, `.bin` and Kotlin's incremental-compile caches.
# All of it is rebuilt from scratch by any `npm run android`, all of it is binary,
# and every one of those files conflicts on merge rather than diffing.
modules/*/android/build/
modules/*/android/.cxx/
modules/*/ios/build/

# design handoff — the prototype and its spec are a local working reference,
# not part of the shipped source. Keep a copy; do not commit it.
docs/decant-handoff/

# `assets/audio/source/` is deliberately NOT ignored, though it was until the
# sounds became real. Those files are the only copies of the takes the shipped
# cues were cut from — every one is CC0 from a third-party site, and "download
# it again" stops being a plan the day a link rots or a pack is re-uploaded
# with different mastering. Without them `script/prepare-sounds.py` cannot
# re-level a cue or re-voice a marimba arrangement; with them the whole audio
# layer rebuilds from one command. 1.7MB in git, nothing in the app — Metro
# bundles only what `src/audio/sounds.ts` requires, which is the `.m4a` set.

# AdMob account IDs, per environment. The committed `.env.example` documents the
# names; the real values belong to whoever owns the AdMob account. Not secret —
# any APK exposes them — but account-specific, so they do not belong in git.
.env
.env.local

# Python bytecode. `script/*.py` regenerate the Lottie files; their cache is
# machine- and interpreter-specific (`cpython-314`), rebuilt on every run, and
# binary — so it conflicts on merge rather than diffing. One was committed.
__pycache__/
*.pyc
